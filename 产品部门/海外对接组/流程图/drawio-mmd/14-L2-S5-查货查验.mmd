%% L2-S5 查货 / 查验 · 归属主链路 S5 · 风控×关务
%% 上接：到仓（风控组内看图/AI） · 下交：H2 已放行 · 关务可执行
%% 扣件含侵权及其他类型；旁路在待配舱只推未扣件资料，再次扣件在旁路拦截
%% draw.io：排列 → 插入 → 高级 → Mermaid…

flowchart LR
  subgraph FK["风控 · 查货（组内）"]
    direction LR
    A["已看图卡点"] --> B["AI 识品牌 / 品名"]
    B --> C["七类合规标记"]
    C --> D{"附加费 / 扣件？"}
    D -->|附加费| E["只加成本·入账"]
    D -->|扣件| HOLD["扣件<br/>侵权是一类 · 另有其他类型"]
    D -->|否| H["查货完结"]
    E --> H
    HOLD --> REL{"已解除？"}
    REL -->|否| WAIT["扣件中 · 未放行"]
    WAIT --> REL
    REL -->|是| GO["放行 → 终配舱"]
    GO --> H
    H --> CABIN["待配舱"]
  end

  subgraph BY["旁路 · 待配舱"]
    direction LR
    PARA["只推未扣件资料给报关行"] --> REHIT{"再次扣件？"}
    REHIT -->|是| STOP["拦截已推资料"]
    REHIT -->|否| KEEP["资料保持已推"]
  end

  subgraph GW["关务 · 查验备注"]
    direction LR
    I["查验报表/查验页"] --> J["功能栏备注"]
    J --> K["登记人=跟进人"]
    K --> L["国内 / 国外分开展示"]
  end

  CABIN -.-> PARA
  CABIN --> H2["H2 → 关务/业务<br/>已放行 · 关务可执行"]
  L --> H2

  style FK fill:#FFF8E1,stroke:#E65100
  style BY fill:#E3F2FD,stroke:#1976D2,stroke-dasharray: 5 3
  style GW fill:#E0F7FA,stroke:#00838F
  style D fill:#FFFDE7,stroke:#F9A825
  style REL fill:#FFFDE7,stroke:#F9A825
  style REHIT fill:#FFFDE7,stroke:#F9A825
  style WAIT fill:#FFEBEE,stroke:#C62828,stroke-dasharray: 5 4
  style STOP fill:#FFEBEE,stroke:#C62828,stroke-dasharray: 5 4
  style H2 fill:#F3E5F5,stroke:#6A1B9A
