%% L1 部门泳道矩阵 · 大图只放小图标题（黑盒）
%% 纵轴=组别 · 按组内阶段推进 · 跨组不画斜线（见 02-H）
%% draw.io：排列 → 插入 → 高级 → Mermaid… → 粘贴本文件全文
%% 不含点价订舱

flowchart TB
  subgraph BJ["报价组 · 橙"]
    direction LR
    BJ1["S1 私卡询价→报价→绑运单<br/>用船务已确认合约价 · 小图 L2-S1"]
  end

  subgraph FK["风控组 · 紫"]
    direction LR
    FK5["S5 查货合规包<br/>小图 L2-S5"]
  end

  subgraph CW["船务组 · 蓝"]
    direction LR
    CW2["S2 运价管理·合约价确认（报价前）<br/>+ 无需报价·价格表自动出价（改配/其他渠道）"]
    CW3["S3 提单管理<br/>业务标记·费用水单 · 小图 L2-S3"]
    CW4["S4 三表/配舱协同"]
    CW6["S6 开船 ∥ 进港口径<br/>小图 L2-S6"]
    CW2 --> CW3 --> CW4 --> CW6
  end

  subgraph GW["关务组 · 青"]
    direction LR
    GW3["S3 取消IT待办"]
    GW4["S4 报关四切片<br/>五环节·分单号·双通道·改配·买单 · 小图 L2-S4"]
    GW5["S5 查验备注<br/>小图 L2-S5"]
    GW3 --> GW4 --> GW5
  end

  subgraph HW["海外对接组 · 红"]
    direction LR
    HW6["S6 接进港/港前准备"]
    HW7["S7 主单预估·尾程预估·尾单/卡派<br/>小图 L2-S7"]
    HW8["S8 尾单转工单<br/>小图 L2-S8"]
    HW6 --> HW7 --> HW8
  end

  TIP["大图规则：格内只写小图名 · 跨组交接用 H1～H8 另图 · 禁止斜线乱穿"]
  HW8 -.-> TIP

  style BJ fill:#FFF3E0,stroke:#E65100,color:#BF360C
  style FK fill:#F3E5F5,stroke:#6A1B9A,color:#4A148C
  style CW fill:#E3F2FD,stroke:#1565C0,color:#0D47A1
  style GW fill:#E0F7FA,stroke:#00838F,color:#006064
  style HW fill:#FFEBEE,stroke:#C62828,color:#B71C1C
  style TIP fill:#FFFDE7,stroke:#F9A825,color:#F57F17
