%% L2-S4 报关四切片 · 归属主链路 S4 · 关务组
%% 上接：到仓/订舱并行 · 下交：H5 与船务；申报放行
%% draw.io：排列 → 插入 → 高级 → Mermaid…

flowchart TB
  START["客户下单 / 有货"] --> P1
  START --> P2

  subgraph P1["并行① 订舱侧（船务协同）"]
    direction LR
    A1["订舱数据/仓位表"] --> A2["配舱·装柜表"]
  end

  subgraph P2["并行② 做资料"]
    direction LR
    B1["客户已上传报关资料<br/>收集截单·磅单"] --> B2{"委托我司？"}
    B2 -->|否| B1
    B2 -->|是| B3["切片① 分单号"]
    B3 --> B4["切片② 资料核准双通道"]
  end

  subgraph P3["舱单 / AMS·ISF"]
    direction LR
    C1["发舱单/AMS/ISF"] --> C1b{"需改单？"}
    C1b -->|否| C2["推代理或海管家"]
    C1b -->|截单资料| Amd1["改单工作台·保函"]
    C1b -->|运抵| Amd2["改运抵·卡截关"]
    C1b -->|舱单| Amd3["先通知报关行勿报关→改舱单"]
    Amd1 --> C2
    Amd2 --> C2
    Amd3 --> C2
  end

  subgraph P4["装柜 → 报关"]
    direction LR
    D1["装柜预配/待配/终配"] --> D2["发报关行·预录回传"]
    D2 --> D3{"核准一致？"}
    D3 -->|否| D2
    D3 -->|是| D4["正式申报·放行"]
    Amd3 -.->|硬拦未完成| D4
  end

  subgraph P5["异常"]
    direction LR
    E1{"国内查验？"} -->|是| E2["切片③ 改配三类"]
    E1 -->|否| E3["出口完成"]
    E2 --> E4["切片④ 买单留底"]
    E3 --> E4
  end

  A2 --> D1
  B4 --> C1
  B4 --> D2
  C2 --> D4
  D4 --> E1
  E4 --> H5["H5 ↔ 船务协同"]

  style START fill:#FAFAFA,stroke:#9E9E9E
  style P2 fill:#E0F7FA,stroke:#00838F
  style P4 fill:#E0F7FA,stroke:#00838F
  style P5 fill:#FFF3E0,stroke:#E65100
  style H5 fill:#FFEBEE,stroke:#C62828
