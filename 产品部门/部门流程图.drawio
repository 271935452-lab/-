        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%% ============================================================\n%% L0 + L1 合体 · 对齐 HTML「产品部门-全流程-大图包小图-评审版」\n%% ① L0 主链路阶段卡片条 + ② L1 部门泳道矩阵（组别×阶段）\n%% 规则：大图只放小图标题；跨组不画斜线（H 另见 02-H）；不含点价订舱\n%% draw.io：排列 → 插入 → 高级 → Mermaid… → 粘贴本文件全文\n%% ============================================================\nflowchart TB\n  %% ========== ① L0 · 主链路阶段（与 HTML .stages 文案一致）==========\n  subgraph L0[\&quot;① L0 · 主链路阶段\&quot;]\n    direction LR\n    S1[\&quot;1&lt;br/&gt;询价报价&lt;br/&gt;私卡 · 报价\&quot;]\n    S2[\&quot;2&lt;br/&gt;合约价确认&lt;br/&gt;报价×船务\&quot;]\n    S3[\&quot;3&lt;br/&gt;提单管理&lt;br/&gt;船务\&quot;]\n    S4[\&quot;4&lt;br/&gt;报关四切片&lt;br/&gt;关务\&quot;]\n    S5[\&quot;5&lt;br/&gt;查货 / 查验&lt;br/&gt;风控×关务\&quot;]\n    S6[\&quot;6&lt;br/&gt;进港&lt;br/&gt;船务→海外\&quot;]\n    S7[\&quot;7&lt;br/&gt;预估 / 尾单&lt;br/&gt;海外\&quot;]\n    S8[\&quot;8&lt;br/&gt;工单边界&lt;br/&gt;海外×工单\&quot;]\n    S1 --&gt; S2 --&gt; S3 --&gt; S4 --&gt; S5 --&gt; S6 --&gt; S7 --&gt; S8\n  end\n  CAP[\&quot;S1 → S2 → S3 → S4 → S5 → S6 → S7 → S8　｜　格子里的名字 = 可点开的小图\&quot;]\n  L0 --&gt; CAP\n  %% ========== ② L1 · 部门泳道矩阵（与 HTML table.matrix 格子一致）==========\n  subgraph L1[\&quot;② L1 · 部门泳道矩阵 · 纵轴=组 · 横轴=S1～S8 · 无斜线\&quot;]\n    direction TB\n    subgraph BJ[\&quot;报价\&quot;]\n      direction LR\n      BJ1[\&quot;S1&lt;br/&gt;私卡询价→报价→绑运单&lt;br/&gt;报价员作业台\&quot;]\n      BJ2[\&quot;S2&lt;br/&gt;合约价「确认」&lt;br/&gt;写回 · H1→船务\&quot;]\n      BJ3[\&quot;S3&lt;br/&gt;—\&quot;]\n      BJ4[\&quot;S4&lt;br/&gt;—\&quot;]\n      BJ5[\&quot;S5&lt;br/&gt;—\&quot;]\n      BJ6[\&quot;S6&lt;br/&gt;—\&quot;]\n      BJ7[\&quot;S7&lt;br/&gt;—\&quot;]\n      BJ8[\&quot;S8&lt;br/&gt;—\&quot;]\n      BJ1 --- BJ2 --- BJ3 --- BJ4 --- BJ5 --- BJ6 --- BJ7 --- BJ8\n    end\n    subgraph FK[\&quot;风控\&quot;]\n      direction LR\n      FK1[\&quot;S1&lt;br/&gt;—\&quot;]\n      FK2[\&quot;S2&lt;br/&gt;—\&quot;]\n      FK3[\&quot;S3&lt;br/&gt;—\&quot;]\n      FK4[\&quot;S4&lt;br/&gt;—\&quot;]\n      FK5[\&quot;S5&lt;br/&gt;查货合规包&lt;br/&gt;H2→关务/业务\&quot;]\n      FK6[\&quot;S6&lt;br/&gt;—\&quot;]\n      FK7[\&quot;S7&lt;br/&gt;—\&quot;]\n      FK8[\&quot;S8&lt;br/&gt;—\&quot;]\n      FK1 --- FK2 --- FK3 --- FK4 --- FK5 --- FK6 --- FK7 --- FK8\n    end\n    subgraph CW[\&quot;船务\&quot;]\n      direction LR\n      CW1[\&quot;S1&lt;br/&gt;—\&quot;]\n      CW2[\&quot;S2&lt;br/&gt;运价管理&lt;br/&gt;确认开关承接\&quot;]\n      CW3[\&quot;S3&lt;br/&gt;提单管理&lt;br/&gt;H3→关务\&quot;]\n      CW4[\&quot;S4&lt;br/&gt;配舱/三表协同\&quot;]\n      CW5[\&quot;S5&lt;br/&gt;—\&quot;]\n      CW6[\&quot;S6&lt;br/&gt;进港口径&lt;br/&gt;H4→海外\&quot;]\n      CW7[\&quot;S7&lt;br/&gt;—\&quot;]\n      CW8[\&quot;S8&lt;br/&gt;—\&quot;]\n      CW1 --- CW2 --- CW3 --- CW4 --- CW5 --- CW6 --- CW7 --- CW8\n    end\n    subgraph GW[\&quot;关务\&quot;]\n      direction LR\n      GW1[\&quot;S1&lt;br/&gt;—\&quot;]\n      GW2[\&quot;S2&lt;br/&gt;—\&quot;]\n      GW3[\&quot;S3&lt;br/&gt;取消IT待办\&quot;]\n      GW4[\&quot;S4&lt;br/&gt;报关四切片&lt;br/&gt;五环节·分单号·双通道·改配·买单&lt;br/&gt;H5↔船务\&quot;]\n      GW5[\&quot;S5&lt;br/&gt;查验备注\&quot;]\n      GW6[\&quot;S6&lt;br/&gt;—\&quot;]\n      GW7[\&quot;S7&lt;br/&gt;—\&quot;]\n      GW8[\&quot;S8&lt;br/&gt;—\&quot;]\n      GW1 --- GW2 --- GW3 --- GW4 --- GW5 --- GW6 --- GW7 --- GW8\n    end\n    subgraph HW[\&quot;海外\&quot;]\n      direction LR\n      HW1[\&quot;S1&lt;br/&gt;—\&quot;]\n      HW2[\&quot;S2&lt;br/&gt;—\&quot;]\n      HW3[\&quot;S3&lt;br/&gt;—\&quot;]\n      HW4[\&quot;S4&lt;br/&gt;—\&quot;]\n      HW5[\&quot;S5&lt;br/&gt;—\&quot;]\n      HW6[\&quot;S6&lt;br/&gt;接进港/港前&lt;br/&gt;承接 H4\&quot;]\n      HW7[\&quot;S7&lt;br/&gt;主单预估·尾程预估&lt;br/&gt;尾单四桶/卡派&lt;br/&gt;H6→工单\&quot;]\n      HW8[\&quot;S8&lt;br/&gt;尾单转工单\&quot;]\n      HW1 --- HW2 --- HW3 --- HW4 --- HW5 --- HW6 --- HW7 --- HW8\n    end\n  end\n  CAP --&gt; L1\n  %% 样式 · 对齐 HTML\n  classDef l0card fill:#FFFFFF,stroke:#1890FF,stroke-width:2px,color:#262626\n  classDef empty fill:#FAFAFA,stroke:#E8E8E8,color:#BFBFBF\n  classDef has fill:#FFFFFF,stroke:#91D5FF,stroke-width:1px,color:#262626\n  classDef cap fill:#FAFAFA,stroke:#D9D9D9,color:#8C8C8C\n  class S1,S2,S3,S4,S5,S6,S7,S8 l0card\n  class CAP cap\n  class BJ1,BJ2,FK5,CW2,CW3,CW4,CW6,GW3,GW4,GW5,HW6,HW7,HW8 has\n  class BJ3,BJ4,BJ5,BJ6,BJ7,BJ8,FK1,FK2,FK3,FK4,FK6,FK7,FK8,CW1,CW5,CW7,CW8,GW1,GW2,GW6,GW7,GW8,HW1,HW2,HW3,HW4,HW5 empty\n  style L0 fill:#E6F7FF,stroke:#0958D9,color:#003A8C\n  style L1 fill:#FAFAFA,stroke:#8C8C8C,color:#262626\n  style BJ fill:#FFF7E6,stroke:#D46B08,color:#D46B08\n  style FK fill:#F9F0FF,stroke:#722ED1,color:#722ED1\n  style CW fill:#E6F7FF,stroke:#1565C0,color:#1565C0\n  style GW fill:#E6FFFB,stroke:#08979C,color:#08979C\n  style HW fill:#FFF1F0,stroke:#CF1322,color:#CF1322\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8qgDhzet0UDg9OS55Pmx-19">
