        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%% L0 部门鸟瞰 · 主链路 8 段\n%% draw.io：排列 → 插入 → 高级 → Mermaid… → 粘贴本文件全文\n%% 不含点价订舱；旁支（时效/POD/邮箱等）不画\nflowchart LR\n  S1[\&quot;S1 询价报价&lt;br/&gt;私卡 · 报价组\&quot;]\n  S2[\&quot;S2 合约价确认&lt;br/&gt;报价 × 船务\&quot;]\n  S3[\&quot;S3 提单管理&lt;br/&gt;船务\&quot;]\n  S4[\&quot;S4 报关四切片&lt;br/&gt;关务\&quot;]\n  S5[\&quot;S5 查货 / 查验&lt;br/&gt;风控 × 关务\&quot;]\n  S6[\&quot;S6 进港&lt;br/&gt;船务 → 海外\&quot;]\n  S7[\&quot;S7 预估 / 尾单&lt;br/&gt;海外\&quot;]\n  S8[\&quot;S8 工单边界&lt;br/&gt;海外 × 工单\&quot;]\n  S1 --&gt; S2 --&gt; S3 --&gt; S4 --&gt; S5 --&gt; S6 --&gt; S7 --&gt; S8\n  NOTE[\&quot;读图：只看货怎么走&lt;br/&gt;细节进 L1 矩阵 / L2 小图\&quot;]\n  S4 -.-&gt; NOTE\n  style S1 fill:#FFF3E0,stroke:#E65100,color:#BF360C\n  style S2 fill:#FFF3E0,stroke:#E65100,color:#BF360C\n  style S3 fill:#E3F2FD,stroke:#1565C0,color:#0D47A1\n  style S4 fill:#E0F7FA,stroke:#00838F,color:#006064\n  style S5 fill:#F3E5F5,stroke:#6A1B9A,color:#4A148C\n  style S6 fill:#E3F2FD,stroke:#1565C0,color:#0D47A1\n  style S7 fill:#FFEBEE,stroke:#C62828,color:#B71C1C\n  style S8 fill:#FFEBEE,stroke:#C62828,color:#B71C1C\n  style NOTE fill:#FAFAFA,stroke:#9E9E9E,color:#616161&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8qgDhzet0UDg9OS55Pmx-1">
