%% 私卡散货 · 询价 × 报价 · 状态对照（2026-08 刷新）
%% 对照 Axure 双轨状态图 + 当前 PRD / 原型
%% draw.io：排列 → 插入 → 高级 → Mermaid…

flowchart LR
  subgraph BIZ["业务询价 · 业务员"]
    direction TB
    B0["草稿<br/>编辑询价 · +新增询价"]
    B1["已提交<br/>提交询价"]
    B2["报价中<br/>无单价 · AI待确认期间"]
    B3["人工已报价<br/>确认报价方案 · 等绑单"]
    B4["已完成<br/>关联运单/订单"]
    B0 --> B1 --> B2 --> B3 --> B4
  end

  subgraph QUO["产品报价 · 报价员"]
    direction TB
    Q0["待报价<br/>收到询价 · 报价/打回"]
    Q1["产品打回<br/>打回备注"]
    Q2["AI待确认<br/>AI完成报价 · 核对确认"]
    Q3["已报价<br/>核对确认完成 · 绑运单"]
    Q4["已完结<br/>确认绑定 · 改绑运单"]
    Q0 --> Q2
    Q0 -->|打回| Q1
    Q2 --> Q3 --> Q4
  end

  B1 -.提交.-> Q0
  B2 -.试算.-> Q2
  Q3 -.回1条单价.-> B3
  Q4 -.绑单锁定.-> B4

  OLD1["已取消：AI已报价"]
  OLD2["已取消：人工已报价"]
  Q2 -.-> OLD1
  Q3 -.-> OLD2

  style BIZ fill:#fff7ed,stroke:#ea580c
  style QUO fill:#fff7ed,stroke:#c2410c
  style Q2 fill:#f3e8ff,stroke:#7c3aed
  style Q3 fill:#e6f4ff,stroke:#0958d9
  style Q4 fill:#dcfce7,stroke:#15803d
  style OLD1 fill:#f1f5f9,stroke:#94a3b8,stroke-dasharray:4 3
  style OLD2 fill:#f1f5f9,stroke:#94a3b8,stroke-dasharray:4 3
