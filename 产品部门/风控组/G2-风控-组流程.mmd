%% 风控组 · 组流程图 · 全流程按组拆分 + 页面功能对照
%% 覆盖：S5 查货合规（组内：看图/AI/扣件放行；终配舱旁路推送）
%% 交接：结束时 H2→关务（已放行可执行）
%% 页面：查货操作原型 / 品名库 / 查货率报表
%% ③ 品名库查询：命中自动标记；未命中手标并沉淀
%% draw.io：排列 → 插入 → 高级 → Mermaid…

flowchart TB
  START(["开始 · 到仓"]) --> A

  A["① 仓库拍图 · 自动 AI 识图<br/>页：查货操作·AI回传列<br/>功能：仓库完成拍图上传后系统自动调用 AI 识图 · 结果回传列表"]
  A --> B

  B["② 产品确认 · 看图卡点<br/>页：查货操作·产品确认侧栏<br/>功能：风控核图 · 点图≥1 · 品名置灰只读"]
  B --> LIB

  LIB["③ 品名库查询<br/>页：品名库·七类合规标记<br/>功能：按品名/品牌检索库内标记"]
  LIB --> HIT

  HIT{"库内是否命中？"}
  HIT -->|命中| AUTO["③a 自动带出合规标记<br/>页：查货确认侧栏回显<br/>功能：七类标记自动勾选"]
  HIT -->|未命中| MANUAL["③b 手动标记<br/>页：确认侧栏·合规标记<br/>功能：人工勾选七类合规标记"]
  MANUAL --> SINK["③c 沉淀回品名库<br/>页：品名库·查货沉淀<br/>功能：反写库 · 闭环积累"]
  AUTO --> C
  SINK --> C

  C["④ 额外服务和扣件标记<br/>页：确认侧栏·额外服务和扣件标记<br/>功能：正式附加费可多选 · 快捷语通知 · 扣件标记"]
  C --> D

  D{"⑤ 是否附加费 / 扣件？"}
  D -->|附加费| E
  D -->|扣件| HOLD
  D -->|否| H

  E["⑥ 添加费用 · 入账<br/>页：查货操作·添加费用<br/>功能：批量默认全选可勾除<br/>超品名费手动加"]
  E --> H

  HOLD["⑦ 扣件<br/>页：查货操作·扣件确定<br/>功能：查货标记+快捷语<br/>企微+系统通知"]
  HOLD --> TYP

  TYP{"扣件类型"}
  TYP -->|侵权| AUTH
  TYP -->|其他| OTH

  AUTH["⑧ 侵权 · 授权或罚款<br/>页：品牌侵权/授权查询 · 待定<br/>功能：原型逻辑尚未定稿"]
  OTH["⑨ 其他扣件处置<br/>页：查货标记勾选<br/>功能：违禁/瞒报/授权等"]
  AUTH --> REL
  OTH --> REL

  REL{"已解除？"}
  REL -->|否| WAIT
  WAIT["⑩ 查货扣件中<br/>页：列表页签「查货扣件中」"]
  WAIT --> REL
  REL -->|是 · 放行| GO

  GO["⑪ 查货扣件放行<br/>页：工具栏·查货扣件放行<br/>功能：双通道通知"]
  GO --> H

  H["⑫ 产品已确认 / 查货完结<br/>页：确认并下一条<br/>功能：批量/单票 · 队列确认"]
  H --> CABIN

  CABIN["终配舱<br/>页：船务/关务·终配舱单"]
  CABIN --> H2
  CABIN -.-> PARA

  PARA["∥ 旁路 · 终配舱<br/>只推未扣件资料给报关行<br/>页：关务/报关侧"]
  PARA --> REHIT
  REHIT{"再次扣件？"}
  REHIT -->|是| STOP["拦截已推资料"]
  REHIT -->|否| KEEP["资料保持已推"]

  H2{{"H2 → 关务/业务<br/>已放行 · 关务可执行"}}
  H2 --> END(["结束 · 已终配舱"])

  classDef step fill:#FFF3E0,stroke:#E65100,color:#BF360C
  classDef wh fill:#FAF5FF,stroke:#7B3FA0,color:#5B2D7A,stroke-width:2px
  classDef dec fill:#FFFDE7,stroke:#F9A825,color:#F57F17
  classDef cross fill:#F3E5F5,stroke:#6A1B9A,color:#4A148C,stroke-width:2px
  classDef back fill:#FFEBEE,stroke:#C62828,color:#B71C1C,stroke-dasharray: 5 4
  classDef para fill:#E3F2FD,stroke:#1976D2,color:#0D47A1,stroke-dasharray: 5 3
  classDef endn fill:#ECEFF1,stroke:#78909C,color:#37474F
  classDef fix fill:#F6FFED,stroke:#52C41A,color:#135200
  class A wh
  class B,C,E,HOLD,AUTH,OTH,GO,H,CABIN,KEEP step
  class LIB,AUTO,MANUAL,SINK fix
  class D,TYP,REL,REHIT,HIT dec
  class H2 cross
  class PARA para
  class WAIT,STOP back
  class START,END endn
