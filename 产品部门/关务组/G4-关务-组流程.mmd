%% 关务组 · 组流程图 · 2026-08-27 更新
%% 覆盖：资料岗预录工作台 · S4 报关四切片 · S5 查验 · 目的港清关
%% 交接：H7←报关行预录 · H5↔船务 · H3←船务 · H4→海外
%% draw.io：排列 → 插入 → 高级 → Mermaid…

flowchart TB
  SIGN["签入"] --> POOL{"报关件 / 整柜代理？"}
  POOL -->|否| SKIP["不进预录工作台"]
  POOL -->|是| PRE0["预录工作台 · 资料岗"]

  PRE0 --> PRE1["待上传资料 → 待推送"]
  PRE1 --> PRE2["推送报关行 #01 · 预录回传/上传"]
  PRE2 --> PRE3["预录待复审 · 手勾确认"]
  PRE3 --> GATE_LCL{"散货 · 终配舱？"}
  GATE_LCL -->|是 · 卡控①| LCL_HOLD["不重推报关行 · 件毛体同步"]
  GATE_LCL -->|整柜无此卡控| PRE4
  LCL_HOLD --> PRE4["待放行 · 出池②"]
  PRE4 --> EXEC["报关执行列表 · 待放行/查验/放行"]

  UP["客户已上传报关资料"] --> A["有资料即按报关编号推 / 到仓出单"]
  PRE0 -.-> A
  A --> BIND{"已绑定提单？"}
  BIND -->|否| WAITB["等绑提单<br/>船务绑主单"]
  WAITB --> BIND
  BIND -->|是 · 绑定提单后| B["自动分单号"]
  B --> GATE{"终配舱完成？"}
  GATE -->|否| WAIT["等终配舱<br/>船务/仓协同"]
  WAIT --> GATE
  RISK["∥ 风控查货（组内）<br/>待配舱只推未扣件资料"]
  A -.-> RISK
  GATE -->|是 · 终配舱后<br/>关务已可执行| C["双通道核准比对<br/>散货必分票 · 整柜看情况"]
  H7{{"H7 ← 报关行<br/>预录回传"}} --> C
  C --> D{"核准通过？"}
  D -->|否| R3["回退 R3<br/>退客户改资料 / 报关行改预录"]
  R3 --> C
  D -->|是| JOIN["P2 汇合 · 门禁打开"]
  RISK -.->|查货完结 · 已可执行| JOIN
  JOIN --> P3A["∥ P3 发舱单 / 下载舱单"]
  JOIN --> P3B["∥ P3 报关申报 · 放行抓取"]
  P3B --> EXEC
  H5{{"H5 · 船务只读订阅<br/>砍跨组对单"}}
  P3A --> H5
  FIX["To-Be：核准后关务闭环直发，不等船务"]
  P3A --> FIX
  P3A --> AMD{"需改单？"}
  P3B --> AMD
  AMD -->|否| INSP
  AMD -->|是| WHERE{"错误落在哪？"}
  WHERE -->|截单资料| AMD1["改单工作台 · 保函"]
  WHERE -->|港区运抵| AMD2["改运抵 · 卡截关期"]
  WHERE -->|舱单| AMD3["先通知报关行勿报关<br/>→ 改舱单 → 再放行报关"]
  AMD1 --> INSP
  AMD2 --> INSP
  AMD3 --> INSP
  INSP["查验登记 · 一键通知客户"] --> GAI{"需改配？"}
  GAI -->|否| CLR
  GAI -->|是| SC["需改配 · 交船务发起"]
  SC --> H5B{{"H5 → 船务<br/>改配由船务发起 · R4"}}
  H5B --> CLR
  H3{{"H3 ← 船务<br/>取消IT→清关待办<br/>仅火车 · 非火车无"}} -.-> CLR
  CLR["目的港清关 · 放行查验<br/>资料·税金·通知清关行"] --> OK["清关放行"]
  OK --> H4{{"H4 → 海外<br/>可港前 / 派送"}}
  H4 --> END(["结束 · 交海外"])

  classDef step fill:#E0F7FA,stroke:#00838F,color:#006064
  classDef dec fill:#FFFDE7,stroke:#F9A825,color:#F57F17
  classDef cross fill:#F3E5F5,stroke:#6A1B9A,color:#4A148C
  classDef back fill:#FFEBEE,stroke:#C62828,color:#B71C1C,stroke-dasharray: 5 4
  classDef para fill:#E3F2FD,stroke:#1976D2,color:#0D47A1,stroke-dasharray: 5 3
  classDef fix fill:#F6FFED,stroke:#52C41A,color:#135200
  classDef endn fill:#ECEFF1,stroke:#78909C,color:#37474F
  classDef pre fill:#E6FFFB,stroke:#08979C,color:#006D75,stroke-width:2px
  class SIGN,SKIP,PRE0,PRE1,PRE2,PRE3,LCL_HOLD,PRE4,EXEC pre
  class UP,A,B,C,JOIN,INSP,SC,CLR,OK,AMD1,AMD2,AMD3,WAIT step
  class POOL,GATE_LCL,GATE,D,AMD,WHERE,GAI dec
  class H7,H5,H5B,H3,H4 cross
  class RISK,P3A,P3B para
  class R3 back
  class FIX fix
  class END endn
