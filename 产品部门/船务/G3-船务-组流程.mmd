%% 船务组 · 组流程图 · 全流程按组拆分
%% 覆盖：S3 提单 · S4 配舱 · S6 进港→离港 · 无需报价·价格表自动出价
%% 交接：私卡报完价回接→船务安排订舱 · 无需报价入口←改配/其他价格表渠道 · H3→关务清关 · H4→海外 · H5←关务舱单/放行只读
%% 本期不含运价管理 / 合约价确认 / 船公司提单号规则 / 进港落库（落箱触发·H4）
%% draw.io：排列 → 插入 → 高级 → Mermaid…

flowchart TB
  subgraph ENTRY["① 入口 · 订舱前"]
    direction TB
    H1B{{"← 私卡报完价<br/>绑运单完成"}}
    GAI["改配"]
    OTH["其他价格表出价渠道"]
    AUTO["无需报价<br/>仅系统按价格表自动出价"]
  end

  H1B --> P1A
  GAI --> AUTO
  OTH --> AUTO
  AUTO --> P1A["② 船务安排<br/>订舱配舱提单"]
  GAI --> RECV["配舱/船期 · R4"]
  RECV --> P1A

  P1B["∥ 关务推送资料<br/>旁路 · 不等排柜"]
  P1A -.-> P1B

  P1A --> B["③ 列表按周 · 同船聚合"]
  B --> C["装完色标 / 业务标记"]
  C --> TR{"是否火车？"}
  TR -->|否| E["截单预警 / 开船盯控"]
  TR -->|是 · 火车| D{"取消 IT？"}
  D -->|是| H3{{"H3 → 关务<br/>清关待办 · 仅火车"}}
  D -->|否| E
  H3 --> E

  H5{{"H5 ← 关务<br/>舱单/放行只读"}} --> F["④ 拉数比对放行状态"]
  E --> F
  F --> G{"已放行？"}
  G -->|否| R6["R6 未放行<br/>标红盯控"]
  R6 --> F
  G -->|是| FT{"飞驼能否抓<br/>进港时间？"}

  subgraph PORT["⑤ 进港"]
    direction TB
    FT
    PULL["飞驼拉进港时间"]
    MAN["人工确认 · 码头补录"]
    ARR{"已进港？"}
    R7["未进港预警"]
    H["进港时间落库<br/>触发落箱等节点"]
  end

  FT -->|能| PULL
  FT -->|不能| MAN
  PULL --> ARR
  MAN --> ARR
  ARR -->|否| R7
  R7 --> ARR
  ARR -->|是| H
  H --> SAIL["⑥ 离港"]
  SAIL --> H4{{"H4 → 海外<br/>离港 / 到港承接"}}
  H4 --> END(["结束 · 交海外港前"])

  classDef step fill:#E3F2FD,stroke:#1565C0,color:#0D47A1
  classDef dec fill:#FFFDE7,stroke:#F9A825,color:#F57F17
  classDef cross fill:#F3E5F5,stroke:#6A1B9A,color:#4A148C
  classDef back fill:#FFEBEE,stroke:#C62828,color:#B71C1C,stroke-dasharray: 5 4
  classDef para fill:#E3F2FD,stroke:#1976D2,color:#0D47A1,stroke-dasharray: 5 3
  classDef endn fill:#ECEFF1,stroke:#78909C,color:#37474F
  class B,C,E,F,H,RECV,PULL,MAN,GAI,OTH,SAIL step
  class TR,D,G,FT,ARR dec
  class H1B,H3,H4,H5 cross
  class P1A,P1B,AUTO para
  class R6,R7 back
  class END endn
